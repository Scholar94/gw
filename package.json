{
  "name": "cac-good-works-site",
  "private": true,
  "description": "CAC Good Works Assembly website: tests and tooling only (the site itself has no build step).",
  "scripts": {
    "test:unit": "node tests/calendar.test.js && node --test tests/feeds.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cac-rules \"node --test tests/rules/\"",
    "test:e2e": "python3 tests/e2e.py",
    "test": "npm run test:unit && npm run test:e2e && npm run test:rules",
    "lint:html": "html-validate *.html",
    "build:seo": "python3 tools/build_seo.py",
    "daily": "node scripts/daily.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@fortawesome/fontawesome-free": "^6.5.2",
    "esbuild": "^0.28.2",
    "fast-xml-parser": "^5.11.2",
    "firebase": "^10.12.2",
    "firebase-tools": "^13.0.0",
    "html-validate": "^8.20.0",
    "ical.js": "^2.1.0"
  }
}
